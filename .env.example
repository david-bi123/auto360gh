# ------------------------------------------------------------------
# Auto360 Gh — Environment variables
# Copy this file to `.env.local` and fill in your values.
# Never commit real credentials — they belong in `.env.local` (gitignored).
# ------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or local MongoDB).
# Leave empty to run the app with the built-in in-memory demo store.
MONGODB_URI=

# Cloudinary credentials for image uploads (admin product images).
# Leave empty to use the built-in premium SVG placeholders.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secret used to sign authentication cookies (JWT).
# IMPORTANT: set a long random value in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Public URL of the application (used for WhatsApp product links & SEO).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enable/disable demo data auto-seed on first run ("true" default).
SEED_DEMO_DATA=true